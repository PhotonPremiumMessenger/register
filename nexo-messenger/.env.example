# ── NEXO Messenger environment template ─────────────────────────────
# Copy to `.env` (inside nexo-messenger/) and fill in real values.
# NEVER commit the real .env file — it is gitignored.

# Port the app (API + WebSocket + static client) listens on
PORT=3000

# Secret used to sign session JWTs. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Session lifetime (default 30 days)
JWT_EXPIRES_IN=30d

# Public base URL of the deployed app, e.g. https://nexo.example.com
# Used for Google OAuth redirects and password-reset links.
# If unset, the server derives it from the incoming request host.
PUBLIC_APP_URL=

# Where the SQLite database + uploaded files live (default: ./data)
DATA_DIR=

# ── Google OAuth (official authorization-code flow) ─────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
#  - Application type: Web application
#  - Authorized JavaScript origins: your PUBLIC_APP_URL
#  - Authorized redirect URI:       {PUBLIC_APP_URL}/api/auth/google/callback
# Until these are set, the "Continue with Google" button reports
# "not configured" — it never fakes a login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Password reset e-mail (optional) ────────────────────────────────
# If SMTP_HOST is set, reset links are e-mailed via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NEXO Messenger <no-reply@nexo.local>"

# Dev fallback: when SMTP is NOT configured and this is "true",
# the forgot-password response includes the reset link directly
# (clearly labelled as dev mode in the UI). Set to false in production.
DEV_EXPOSE_RESET_LINK=true

# ── Uploads ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
